{
  "name": "homebridge-smartlife-cloud",
  "displayName": "SmartLife Cloud",
  "type": "module",
  "version": "0.2.1",
  "description": "Homebridge platform plugin that controls SmartLife devices through SmartLife cloud.",
  "author": "Marcel",
  "license": "Apache-2.0",
  "keywords": [
    "homebridge-plugin",
    "smartlife",
    "tuya",
    "cloud"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "version:bump:major": "npm version major",
    "version:bump:minor": "npm version minor",
    "version:bump:revision": "npm version patch",
    "publish:plugin": "bash ./scripts/publish.sh",
    "publish:plugin:dry-run": "bash ./scripts/publish.sh --dry-run",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "homebridge": "^1.11.2",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
